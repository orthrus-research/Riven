// The atlas map site at map.orthrus.cc: static assets only, built by
// `tools/terrain_atlas.py map` into .local/map/site and deployed with `map --deploy`.
// The account comes from the wrangler login.
{
  "name": "orthrus-map",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../../.local/map/site",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "map.orthrus.cc",
      "custom_domain": true
    }
  ]
}
