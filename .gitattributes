# Text is stored and checked out with LF on every platform; Ruff and the Java formatter expect LF.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jar binary

# Generated by tools/content/build_content.py; --check compares bytes, so keep LF.
src/main/resources/assets/riven/** text eol=lf
src/main/resources/assets/riven/**/*.png binary
