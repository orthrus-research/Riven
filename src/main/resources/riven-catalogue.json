    "air": "empty space",
    "fluid": "water and lava",
    "soil": "ground plants root in",
    "sediment": "loose sand, gravel, clay and ash",
    "ice": "snow and ice",
    "rock": "solid rock, from vanilla stones to Riven host stones and realm rocks",
    "formation": "pointed pieces that grow from cave floors and ceilings",
    "plant": "plants and fungi the generator places",
    "decor": "other placed objects"
  },
